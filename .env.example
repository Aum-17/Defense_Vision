# ===== DefenceVision Environment Configuration =====
# Copy to .env and adjust. Never commit real credentials.

# --- General ---
APP_NAME=DefenceVision
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# --- Frontend ---
FRONTEND_PORT=3000

# --- Database ---
# Docker (PostGIS default):
DATABASE_URL=postgresql://defence:defence@db:5432/defencevision
# Local SQLite fallback (no Docker DB service):
# DATABASE_URL=sqlite:///./data/defencevision.db
POSTGRES_USER=defence
POSTGRES_PASSWORD=defence
POSTGRES_DB=defencevision

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Uploads ---
MAX_UPLOAD_MB=25
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.tif,.tiff

# --- Data root ---
DATA_ROOT=./data
